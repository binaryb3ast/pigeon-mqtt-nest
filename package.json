{
  "name": "pigeon-mqtt-nest",
  "version": "2.0.0",
  "description": "A NestJS module for running and integrating an Aedes MQTT broker with topic decorators, lifecycle hooks, authentication, authorization, and message handlers.",
  "author": {
    "name": "Binary Beast"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/binaryb3ast/pigeon-mqtt-nest.git"
  },
  "bugs": {
    "url": "https://github.com/binaryb3ast/pigeon-mqtt-nest/issues"
  },
  "homepage": "https://github.com/binaryb3ast/pigeon-mqtt-nest#readme",
  "keywords": [
    "mqtt",
    "aedes",
    "mqtt-broker",
    "mqtt-server",
    "nestjs",
    "nest",
    "iot"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "npm run clean && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "check": "npm run format:check && npm run lint && npm test && npm run build",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.21",
    "@nestjs/core": "^11.1.21",
    "rxjs": "^7.8.1"
  },
  "dependencies": {
    "@golevelup/nestjs-discovery": "^7.0.3",
    "aedes": "^1.2.0",
    "aedes-server-factory": "^0.2.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/common": "^11.1.21",
    "@nestjs/core": "^11.1.21",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.21",

    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",

    "jest": "^30.5.2",
    "prettier": "^3.6.0",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.4.13",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}